# ================================================================
# 环境变量模板 — 复制为 .env 并修改
#   cp .env.example .env
#
# 这是项目唯一的 .env 文件，用于 Docker Compose 容器运行。
# 身份验证通过前端 Konami 码（↑↑↓↓←→←→BABA）完成，无需额外密码。
# ================================================================

# MySQL 容器
MYSQL_ROOT_PASSWORD=请替换为随机密码
MYSQL_DATABASE=photodb

# 应用
DB_HOST=mysql
DB_USERNAME=root
DB_PASSWORD=${MYSQL_ROOT_PASSWORD}
JWT_SECRET=请替换为 openssl rand -base64 32 的输出

# Redis（缓存，prod 启动强校验 REDIS_PASSWORD 非空）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=请替换为随机密码

# RabbitMQ（消息队列，prod 启动强校验：RABBIT_USER 不能用默认 admin、RABBIT_PASS 非空）
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_USER=请替换为自定义用户名（不能是 admin）
RABBIT_PASS=请替换为随机密码

# Prometheus 监控抓取凭据（/actuator/prometheus Basic Auth，prod 强校验非空）
MONITORING_USER=请替换为自定义用户名
MONITORING_PASSWORD=请替换为随机密码

# Grafana 面板管理密码（http://127.0.0.1:3000 本地访问，匿名登录已关闭）
GF_SECURITY_ADMIN_PASSWORD=请替换为随机密码
