# === 本地开发配置模板 ===
# 使用方法：复制此文件为 application-local.yml，修改为你的实际配置
#   cp application-local.yml.example application-local.yml
# application-local.yml 已在 .gitignore 中，不会被提交
#
# 注意：如果值包含特殊字符（@ ` ? { } [ ] : , & * # ? | - < > = ! %），
#       请用引号包裹，例如 DB_PASSWORD: "@my-p@ssword"
#       YAML 允许单引号 'value' 或双引号 "value"

# 数据库密码（本地 MySQL root 密码）
DB_PASSWORD: "your-password-here"

# JWT 签名密钥（本地开发用固定值即可）
JWT_SECRET: dev-secret-do-not-use-in-production

# === 如需本地测试 Redis 缓存，取消以下注释 ===
# spring:
#   cache:
#     type: redis
#   data:
#     redis:
#       host: localhost
#       port: 6379
#       password:
# 覆盖后本地 dev 将使用 Redis 替代 Caffeine 缓存

# === 如需本地测试 RabbitMQ 消息队列，取消以下注释 ===
# spring:
#   rabbitmq:
#     host: localhost
#     port: 5672
#     username: admin
#     password:
# photo:
#   processing:
#     type: rabbitmq
# 覆盖后本地 dev 将使用 RabbitMQ 替代 @Async 线程池

# === 本地开发即可访问 Prometheus metrics ===
# dev profile 默认暴露 /actuator/prometheus（无需额外配置）
# 访问: curl http://localhost:8080/actuator/prometheus
# 输出: jvm_memory_used_bytes, http_server_requests_seconds_count, photo.upload.total 等
